<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg_dark"
    android:padding="20dp"
    android:gravity="center_vertical">

    <TextView
        android:id="@+id/ticker_task_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Task Name"
        android:textColor="#4FC3F7"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginBottom="12dp" />

    <!-- Pill container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/shape_pill_blue"
        android:orientation="vertical"
        android:paddingVertical="10dp"
        android:paddingHorizontal="8dp">

        <!-- Numbers row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:id="@+id/ticker_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="22"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:fontFeatureSettings="tnum" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="•" android:textColor="#80FFFFFF" android:textSize="8sp" android:lineSpacingExtra="0dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="•" android:textColor="#80FFFFFF" android:textSize="8sp" android:lineSpacingExtra="0dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ticker_hours"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="04"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:fontFeatureSettings="tnum" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="6dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="•" android:textColor="#80FFFFFF" android:textSize="8sp" android:lineSpacingExtra="0dp"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="•" android:textColor="#80FFFFFF" android:textSize="8sp" android:lineSpacingExtra="0dp"/>
            </LinearLayout>

            <TextView
                android:id="@+id/ticker_mins"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="21"
                android:textColor="#FFFFFF"
                android:textSize="26sp"
                android:fontFamily="monospace"
                android:fontFeatureSettings="tnum" />

        </LinearLayout>

        <!-- Labels row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="2dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="days"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="hours"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="min"
                android:textColor="#80FFFFFF"
                android:textSize="10sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/ticker_expired"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXPIRED"
        android:textColor="#F44336"
        android:textSize="18sp"
        android:fontFamily="sans-serif-bold"
        android:visibility="gone" />

</LinearLayout>
